# Local CRM secrets. Copy to `.env.local` and fill real values.
#
# Used by `pnpm send`, `/api/send`, and `pnpm postmark:check`.
POSTMARK_API_KEY=

# Required only for Clerk-backed dynamic groups and manual sync.
CLERK_SECRET_KEY=

# Optional for the Temporal hourly signup email worker.
# If omitted, temporal/* loads the dev values from ../cctools/relay/.env.local.
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
TEMPORAL_API_KEY=
TEMPORAL_SIGNUP_EMAIL_TASK_QUEUE=rebyte-crm-hourly-signup-email-dev
TEMPORAL_SIGNUP_EMAIL_ACTIVITY_CONCURRENCY=1
